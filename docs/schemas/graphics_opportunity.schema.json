{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authorization",
    "opportunity_id",
    "project_id",
    "timeline_id",
    "timeline_sha256",
    "draft_sequence",
    "start_us",
    "end_us",
    "concept",
    "rationale",
    "grounding_policy",
    "grounding_refs",
    "unresolved_facts",
    "prompt"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "graphics_suggestion"
    },
    "authorization": {
      "const": "suggestion_only"
    },
    "opportunity_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "timeline_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "timeline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "draft_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "start_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_us": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "concept": {
      "$ref": "#/$defs/text"
    },
    "rationale": {
      "$ref": "#/$defs/text"
    },
    "grounding_policy": {
      "const": "use_referenced_evidence_only"
    },
    "grounding_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "evidence_id",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "kind": {
            "enum": [
              "transcript",
              "frame",
              "approved_branding",
              "project_note"
            ]
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
          },
          "excerpt": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "unresolved_facts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_format",
        "duration_us",
        "frame_rate",
        "audio",
        "visual_concept",
        "reveal_order",
        "exact_onscreen_words",
        "style",
        "motion",
        "title_safe_margins",
        "action_safe_margins",
        "transparency"
      ],
      "properties": {
        "asset_format": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "const": 1920
            },
            "height": {
              "const": 1080
            }
          }
        },
        "duration_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frame_rate": {
          "$ref": "#/$defs/rational"
        },
        "audio": {
          "const": false
        },
        "visual_concept": {
          "$ref": "#/$defs/text"
        },
        "reveal_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "exact_onscreen_words": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "style": {
          "$ref": "#/$defs/text"
        },
        "motion": {
          "$ref": "#/$defs/text"
        },
        "title_safe_margins": {
          "$ref": "#/$defs/margins"
        },
        "action_safe_margins": {
          "$ref": "#/$defs/margins"
        },
        "transparency": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-editor.local/schemas/graphics_opportunity.schema.json",
  "title": "Suggestion-only graphics opportunity",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\x00-\\x1f]+$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        },
        "right": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        },
        "bottom": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        },
        "left": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        }
      }
    }
  },
  "description": "No asset creation, placement, export or source/master format mutation. 1920x1080 is only the proposed separate asset. Runtime additionally checks active identity/hash/sequence, range within final cut, exact duration and rational frame-rate equality, unique grounding IDs, and title margins no smaller than action margins. Structural references do not prove factual truth, editorial usefulness or privacy of freeform wording; upstream context minimization and review remain required."
}
