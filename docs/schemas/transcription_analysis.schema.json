{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-editor.local/schemas/transcription_analysis.schema.json",
  "title": "Local silence analysis",
  "description": "Path-free analysis of one immutable source. Silence is evidence only; it never authorizes an edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_id",
    "source_sha256",
    "duration_us",
    "silence_policy",
    "silences"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "duration_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "silence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "noise_db", "minimum_duration_us"],
      "properties": {
        "version": { "const": "1" },
        "noise_db": { "type": "number", "minimum": -120, "maximum": 0 },
        "minimum_duration_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "silences": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_us", "end_us"],
        "properties": {
          "start_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_us": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "x-greaterThan": "start_us"
          }
        },
        "description": "Half-open source-time interval. Runtime validates ordering, duration bounds, and minimum silence length."
      }
    }
  }
}
