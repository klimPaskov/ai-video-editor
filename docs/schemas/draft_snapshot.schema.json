{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-video-editor.invalid/draft_snapshot.schema.json",
  "title": "Committed active draft snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "draft_id",
    "base_revision_id",
    "draft_sequence",
    "timeline_sha256",
    "head_transaction_sha256",
    "timeline"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "draft_id": { "$ref": "#/$defs/id" },
    "base_revision_id": { "$ref": "#/$defs/id" },
    "draft_sequence": { "type": "integer", "minimum": 0 },
    "timeline_sha256": { "$ref": "#/$defs/hash" },
    "head_transaction_sha256": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "timeline": { "$ref": "timeline.schema.json" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
