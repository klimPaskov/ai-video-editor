{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-video-editor.invalid/two_source_initial_project.schema.json",
  "title": "Verified two-source initial project baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "sources", "source_probes", "source_timings", "timeline", "revision"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "project": { "$ref": "project.schema.json" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "source.schema.json" }
    },
    "source_probes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "object" }
    },
    "source_timings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeBaseNumerator", "timeBaseDenominator", "firstPts", "lastPts", "lastDurationTicks", "frameCount", "presentationEndUs"],
        "properties": {
          "timeBaseNumerator": { "type": "integer", "minimum": 1 },
          "timeBaseDenominator": { "type": "integer", "minimum": 1 },
          "firstPts": { "const": 0 },
          "lastPts": { "type": "integer", "minimum": 0 },
          "lastDurationTicks": { "type": "integer", "minimum": 1 },
          "frameCount": { "type": "integer", "minimum": 1 },
          "presentationEndUs": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "timeline": { "$ref": "timeline.schema.json" },
    "revision": { "$ref": "revision.schema.json" }
  }
}
